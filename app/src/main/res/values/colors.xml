<?xml version="1.0" encoding="utf-8"?>
<!--
  For the home-screen widget only (F-68): Glance's plain content-color model
  can't read the in-app Compose theme (palette choice, dynamic light/dark),
  so these are a fixed light/dark pair lifted from the default Mercado fresco
  palette's surface/onSurface/outline/primary tones — see
  ui/theme/palette/MercadoFrescoPalette.kt. The widget doesn't follow a
  Garden/Indigo palette choice; a known, deliberate simplification.
-->
<resources>
    <color name="widget_background">#FFFDF7</color>
    <color name="widget_on_background">#1A231F</color>
    <color name="widget_muted">#59685E</color>
    <color name="widget_accent">#0B8475</color>
</resources>
