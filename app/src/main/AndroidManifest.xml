<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name=".EatApplication"
        android:supportsRtl="true"
        android:theme="@style/Theme.EatApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EatApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets a restaurant file shared from another app (WhatsApp,
                 Gmail, Files...) reopen EatApp with "Open with EatApp". The
                 file itself is untrusted input, validated before anything
                 reaches Room — see data/share/RestaurantImportReader.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Exposes cacheDir/shared/ (see res/xml/file_paths.xml) as a
             content:// Uri so the file built by writeRestaurantShareFile can
             be handed to another app via Intent.ACTION_SEND without granting
             it broader filesystem access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
