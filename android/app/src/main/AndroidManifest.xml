<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The QR scanner (mobile_scanner) is the app's only camera user, and
         scanning an invitation QR is the only thing it does with it. This is
         the app's single permission; the rest of the app still declares none,
         and the sharing flow still needs none. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:label="EatApp"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's own deep linking is turned off so the app_links
                 plugin (not the framework's route-by-name handling) receives
                 the eatapp://join/<token> intent below and hands it to the
                 shell. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lets a restaurant file shared from another app (WhatsApp, Gmail,
                 Files...) reopen EatApp with "Open with EatApp". A plain
                 standard application/json matches what the outgoing share sets,
                 and the two generic types cover apps that don't preserve it.
                 The file itself is untrusted input, validated before anything
                 reaches the database — see lib/data/share/restaurant_import_reader.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Fallback for the ".eatapp" extension the writer names the file
                 with: a local file manager commonly hands back a content:// Uri
                 whose path mirrors the real filename and looks up the type from
                 the extension, rather than preserving the MIME type set on the
                 outgoing share. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.eatapp" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.eatapp" />
            </intent-filter>
            <!-- Invitation links: eatapp://join/<token>. Delivered to the app
                 by the app_links plugin, which hands the URI to the shell's
                 join screen. BROWSABLE so a link tapped in a browser or chat
                 reaches us. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eatapp" android:host="join" />
            </intent-filter>
            <!-- The provider sign-in redirect: eatapp://login-callback. It reuses
                 the same scheme, on its own host, so the browser can hand the
                 OAuth callback straight back to the app for the identity gateway
                 to exchange for a session. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eatapp" android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- The "Want to try" home-screen widget. The provider draws the card
             from data the Dart side publishes through the home_widget plugin;
             see android/app/src/main/kotlin/com/saatxi/eatapp/EatAppHomeWidgetProvider.kt. -->
        <receiver
            android:name=".EatAppHomeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eatapp_home_widget_info" />
        </receiver>
        <!-- Runs the widget's shuffle button in a headless Flutter engine, which
             calls back into homeWidgetBackgroundCallback. Required by the
             home_widget plugin; without it the button would do nothing. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
