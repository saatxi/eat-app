<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen's ground. It is the light surface tone of the Terracota
  palette (neutral t98 — see
  lib/core/theme/palettes/terracotta_palette.dart), so the window Android
  paints while the engine starts is the same colour as the first frame the app
  paints, and the hand-off between them does not flash. The night value is the
  dark-mode surface of the same palette.
-->
<resources>
    <color name="splash_background">#FDF8F2</color>
</resources>
