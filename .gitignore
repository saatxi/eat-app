*.iml
/local.properties
/.idea
.DS_Store
/build
**/build
/captures

# Signing keystores must never be committed
*.jks
*.keystore

# Android Studio Navigation editor temp files
.scratch/

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
app.*.symbols
app.*.map.json

# Gradle/Kotlin build caches created by Flutter's Android build
.gradle/
.kotlin/

# The app is Android-only (no ios/ project); the Flutter tool regenerates a
# stub ios/ directory of ephemeral build glue on `pub get`/`build` even so.
/ios/

# Widget Preview related
.widget_preview/

# Android Studio IDE state created when opening android/ directly as a project
android/.idea/

# Gradle daemon JVM toolchain file generated by updateDaemonJvm (machine-specific)
android/gradle/gradle-daemon-jvm.properties

# Supabase CLI local state (project link credentials)
supabase/.temp/

# Local Supabase config for `flutter run --dart-define-from-file` (see
# .vscode/launch.json). Holds the project URL and anon key, so it must never be
# committed.
/dart_defines.json
